generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

/// Branch record — single outlet for v1, multi-outlet-ready
model Outlet {
  id             String          @id @default(uuid())
  name           String
  branchCode     String          @unique @map("branch_code")
  address        String?
  timezone       String          @default("Asia/Jakarta")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  inventoryItems InventoryItem[]
  orders         Order[]
  shifts         Shift[]
  users          User[]

  @@map("outlets")
}

/// Login account with fixed role enum
model User {
  id               String            @id @default(uuid())
  username         String            @unique
  passwordHash     String            @map("password_hash")
  fullName         String            @map("full_name")
  role             Role
  outletId         String            @map("outlet_id")
  active           Boolean           @default(true)
  rememberMeToken  String?           @map("remember_me_token")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  auditLogs        AuditLog[]
  orderEditLogs    OrderEditLog[]
  ordersCancelled  Order[]           @relation("OrderCancelledBy")
  ordersCreated    Order[]           @relation("OrderCreatedBy")
  ordersPrepared   Order[]           @relation("OrderPreparedBy")
  ordersPrinted    Order[]           @relation("OrderPrintedBy")
  payments         Payment[]
  refunds          Refund[]
  shiftsClosed     Shift[]           @relation("ShiftClosedBy")
  shiftsOpened     Shift[]           @relation("ShiftOpenedBy")
  stockConversions StockConversion[]
  stockMovements   StockMovement[]
  outlet           Outlet            @relation(fields: [outletId], references: [id])

  @@map("users")
}

/// One row per Buka Toko → Tutup Toko cycle
model Shift {
  id                  String      @id @default(uuid())
  outletId            String      @map("outlet_id")
  openedById          String      @map("opened_by_id")
  openedAt            DateTime    @default(now()) @map("opened_at")
  closedById          String?     @map("closed_by_id")
  closedAt            DateTime?   @map("closed_at")
  status              ShiftStatus @default(OPEN)
  openingCash         Decimal?    @map("opening_cash") @db.Decimal(12, 2)
  closingCashExpected Decimal?    @map("closing_cash_expected") @db.Decimal(12, 2)
  closingCashActual   Decimal?    @map("closing_cash_actual") @db.Decimal(12, 2)
  closedBy            User?       @relation("ShiftClosedBy", fields: [closedById], references: [id])
  openedBy            User        @relation("ShiftOpenedBy", fields: [openedById], references: [id])
  outlet              Outlet      @relation(fields: [outletId], references: [id])

  @@map("shifts")
}

/// Egg Waffle main toppings — 12 items, 3 series
model ToppingUtama {
  id               String        @id @default(uuid())
  name             String        @unique
  series           ToppingSeries
  priceDirect      Decimal       @map("price_direct") @db.Decimal(12, 2)
  priceGrabGo      Decimal       @map("price_grab_go") @db.Decimal(12, 2)
  priceShopee      Decimal       @map("price_shopee") @db.Decimal(12, 2)
  gramPerPortion   Decimal       @map("gram_per_portion") @db.Decimal(8, 2)
  active           Boolean       @default(true)
  sortOrder        Int           @default(0) @map("sort_order")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  halfPartnerItems OrderItem[]   @relation("HalfPartnerTopping")
  orderItems       OrderItem[]   @relation("PrimaryTopping")
  recipes          Recipe[]      @relation("RecipeTopping")

  @@map("topping_utama")
}

/// Egg Waffle flavours — 5 items
model Flavour {
  id               String      @id @default(uuid())
  name             String      @unique
  extraPriceDirect Decimal     @map("extra_price_direct") @db.Decimal(12, 2)
  extraPriceOnline Decimal     @map("extra_price_online") @db.Decimal(12, 2)
  ingredientUsage  String?     @map("ingredient_usage")
  active           Boolean     @default(true)
  sortOrder        Int         @default(0) @map("sort_order")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  orderItems       OrderItem[]
  recipes          Recipe[]    @relation("RecipeFlavour")

  @@map("flavours")
}

/// Egg Waffle add-ons — 4 items, multi-select
model Addon {
  id               String           @id @default(uuid())
  name             String           @unique
  extraPriceDirect Decimal          @map("extra_price_direct") @db.Decimal(12, 2)
  extraPriceOnline Decimal          @map("extra_price_online") @db.Decimal(12, 2)
  usagePerPortion  String?          @map("usage_per_portion")
  active           Boolean          @default(true)
  sortOrder        Int              @default(0) @map("sort_order")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  orderItemAddons  OrderItemAddon[]
  recipes          Recipe[]         @relation("RecipeAddon")

  @@map("addons")
}

/// Drinks — 7 items (Coffee / Non-Coffee)
model Drink {
  id          String      @id @default(uuid())
  name        String      @unique
  drinkType   String      @map("drink_type")
  priceDirect Decimal     @map("price_direct") @db.Decimal(12, 2)
  priceGrabGo Decimal     @map("price_grab_go") @db.Decimal(12, 2)
  priceShopee Decimal     @map("price_shopee") @db.Decimal(12, 2)
  active      Boolean     @default(true)
  sortOrder   Int         @default(0) @map("sort_order")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  orderItems  OrderItem[]
  recipes     Recipe[]    @relation("RecipeDrink")

  @@map("drinks")
}

/// Fixed lookup: sweetness levels
model SweetnessLevel {
  id         String      @id @default(uuid())
  name       String      @unique
  percentage Int
  sortOrder  Int         @default(0) @map("sort_order")
  orderItems OrderItem[]

  @@map("sweetness_levels")
}

/// Fixed lookup: iced levels
model IcedLevel {
  id         String      @id @default(uuid())
  name       String      @unique
  percentage Int
  sortOrder  Int         @default(0) @map("sort_order")
  orderItems OrderItem[]

  @@map("iced_levels")
}

/// Order channel config — 6 channels
model Channel {
  id             String  @id @default(uuid())
  name           String  @unique
  priceTier      String  @map("price_tier")
  commissionPct  Decimal @map("commission_pct") @db.Decimal(5, 2)
  flatFee        Decimal @map("flat_fee") @db.Decimal(12, 2)
  settlesTo      String  @map("settles_to")
  isPlatform     Boolean @map("is_platform")
  customerPrefix String? @map("customer_prefix")
  active         Boolean @default(true)
  sortOrder      Int     @default(0) @map("sort_order")
  orders         Order[]

  @@map("channels")
}

/// One row per order — format BRnnnyymmddxxxaabb
model Order {
  id             String         @id @default(uuid())
  orderNumber    String         @unique @map("order_number")
  outletId       String         @map("outlet_id")
  channelId      String         @map("channel_id")
  customerData   String?        @map("customer_data")
  notes          String?
  status         OrderStatus    @default(OPEN)
  paymentStatus  PaymentStatus  @default(UNPAID) @map("payment_status")
  prepared       Boolean        @default(false)
  preparedById   String?        @map("prepared_by_id")
  preparedAt     DateTime?      @map("prepared_at")
  cancelReason   String?        @map("cancel_reason")
  cancelledById  String?        @map("cancelled_by_id")
  cancelledAt    DateTime?      @map("cancelled_at")
  createdById    String         @map("created_by_id")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  printedAt      DateTime?      @map("printed_at")
  printedById    String?        @map("printed_by_id")
  refunded       Boolean        @default(false)
  discountId     String?        @map("discount_id")
  discountAmount Decimal?       @map("discount_amount") @db.Decimal(12, 2)
  editLogs       OrderEditLog[]
  items          OrderItem[]
  cancelledBy    User?          @relation("OrderCancelledBy", fields: [cancelledById], references: [id])
  channel        Channel        @relation(fields: [channelId], references: [id])
  createdBy      User           @relation("OrderCreatedBy", fields: [createdById], references: [id])
  discount       Discount?      @relation(fields: [discountId], references: [id])
  outlet         Outlet         @relation(fields: [outletId], references: [id])
  preparedBy     User?          @relation("OrderPreparedBy", fields: [preparedById], references: [id])
  printedBy      User?          @relation("OrderPrintedBy", fields: [printedById], references: [id])
  payments       Payment[]
  refunds        Refund[]

  @@index([outletId, status])
  @@index([outletId, createdAt])
  @@map("orders")
}

/// Line items within an order
model OrderItem {
  id                   String           @id @default(uuid())
  orderId              String           @map("order_id")
  productType          ProductType      @map("product_type")
  toppingId            String?          @map("topping_id")
  halfPartnerToppingId String?          @map("half_partner_topping_id")
  flavourId            String?          @map("flavour_id")
  drinkId              String?          @map("drink_id")
  sweetnessLevelId     String?          @map("sweetness_level_id")
  icedLevelId          String?          @map("iced_level_id")
  qty                  Int              @default(1)
  unitPrice            Decimal          @map("unit_price") @db.Decimal(12, 2)
  lineTotal            Decimal          @map("line_total") @db.Decimal(12, 2)
  prepared             Boolean          @default(false)
  addons               OrderItemAddon[]
  drink                Drink?           @relation(fields: [drinkId], references: [id])
  flavour              Flavour?         @relation(fields: [flavourId], references: [id])
  halfPartner          ToppingUtama?    @relation("HalfPartnerTopping", fields: [halfPartnerToppingId], references: [id])
  icedLevel            IcedLevel?       @relation(fields: [icedLevelId], references: [id])
  order                Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sweetnessLevel       SweetnessLevel?  @relation(fields: [sweetnessLevelId], references: [id])
  topping              ToppingUtama?    @relation("PrimaryTopping", fields: [toppingId], references: [id])

  @@map("order_items")
}

/// Junction table for order item ↔ addon (multi-select)
model OrderItemAddon {
  id          String    @id @default(uuid())
  orderItemId String    @map("order_item_id")
  addonId     String    @map("addon_id")
  addon       Addon     @relation(fields: [addonId], references: [id])
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([orderItemId, addonId])
  @@map("order_item_addons")
}

/// Tender records — supports split-tender (Cash+QRIS)
model Payment {
  id             String        @id @default(uuid())
  orderId        String        @map("order_id")
  method         PaymentMethod
  cashAmount     Decimal       @default(0) @map("cash_amount") @db.Decimal(12, 2)
  qrisAmount     Decimal       @default(0) @map("qris_amount") @db.Decimal(12, 2)
  transferAmount Decimal       @default(0) @map("transfer_amount") @db.Decimal(12, 2)
  totalTendered  Decimal       @map("total_tendered") @db.Decimal(12, 2)
  changeGiven    Decimal       @default(0) @map("change_given") @db.Decimal(12, 2)
  paidById       String        @map("paid_by_id")
  paidAt         DateTime      @default(now()) @map("paid_at")
  order          Order         @relation(fields: [orderId], references: [id])
  paidBy         User          @relation(fields: [paidById], references: [id])

  @@map("payments")
}

/// Raw material master data
model Ingredient {
  id                String            @id @default(uuid())
  name              String            @unique
  unit              String
  packageSize       String?           @map("package_size")
  currentStock      Decimal           @default(0) @map("current_stock") @db.Decimal(12, 4)
  lowStockThreshold Decimal?          @map("low_stock_threshold") @db.Decimal(12, 4)
  ingredientGroup   String?           @map("ingredient_group")
  isDerived         Boolean           @default(false) @map("is_derived")
  active            Boolean           @default(true)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  recipes           Recipe[]
  conversionsIn     StockConversion[] @relation("ConversionInput")
  conversionsOut    StockConversion[] @relation("ConversionOutput")
  stockMovements    StockMovement[]

  @@map("ingredients")
}

/// Links sellable option to ingredient + qty consumed per unit
model Recipe {
  id           String        @id @default(uuid())
  toppingId    String?       @map("topping_id")
  flavourId    String?       @map("flavour_id")
  addonId      String?       @map("addon_id")
  drinkId      String?       @map("drink_id")
  ingredientId String        @map("ingredient_id")
  qtyPerUnit   Decimal       @map("qty_per_unit") @db.Decimal(12, 4)
  addon        Addon?        @relation("RecipeAddon", fields: [addonId], references: [id])
  drink        Drink?        @relation("RecipeDrink", fields: [drinkId], references: [id])
  flavour      Flavour?      @relation("RecipeFlavour", fields: [flavourId], references: [id])
  ingredient   Ingredient    @relation(fields: [ingredientId], references: [id])
  topping      ToppingUtama? @relation("RecipeTopping", fields: [toppingId], references: [id])

  @@map("recipes")
}

/// Every stock change event
model StockMovement {
  id            String            @id @default(uuid())
  ingredientId  String            @map("ingredient_id")
  movementType  StockMovementType @map("movement_type")
  qty           Decimal           @db.Decimal(12, 4)
  reason        String?
  referenceId   String?           @map("reference_id")
  performedById String            @map("performed_by_id")
  performedAt   DateTime          @default(now()) @map("performed_at")
  ingredient    Ingredient        @relation(fields: [ingredientId], references: [id])
  performedBy   User              @relation(fields: [performedById], references: [id])

  @@index([ingredientId, performedAt])
  @@map("stock_movements")
}

/// Gula Aren-style production: output ingredient + input ingredient
model StockConversion {
  id                 String     @id @default(uuid())
  outputIngredientId String     @map("output_ingredient_id")
  outputQty          Decimal    @map("output_qty") @db.Decimal(12, 4)
  inputIngredientId  String     @map("input_ingredient_id")
  inputQty           Decimal    @map("input_qty") @db.Decimal(12, 4)
  performedById      String     @map("performed_by_id")
  performedAt        DateTime   @default(now()) @map("performed_at")
  inputIngredient    Ingredient @relation("ConversionInput", fields: [inputIngredientId], references: [id])
  outputIngredient   Ingredient @relation("ConversionOutput", fields: [outputIngredientId], references: [id])
  performedBy        User       @relation(fields: [performedById], references: [id])

  @@map("stock_conversions")
}

/// Non-ingredient assets (dish soap, coffee machine, etc.)
model InventoryItem {
  id        String   @id @default(uuid())
  outletId  String   @map("outlet_id")
  name      String
  unit      String?
  qty       Decimal  @default(0) @db.Decimal(12, 4)
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  outlet    Outlet   @relation(fields: [outletId], references: [id])

  @@map("inventory_items")
}

/// Flexible promo rules
model Discount {
  id                 String    @id @default(uuid())
  name               String
  promoType          PromoType @map("promo_type")
  rulePayload        Json      @map("rule_payload")
  validFrom          DateTime? @map("valid_from")
  validTo            DateTime? @map("valid_to")
  applicableChannels String[]  @map("applicable_channels")
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  orders             Order[]

  @@map("discounts")
}

/// Post-Done refund records (proposed)
model Refund {
  id           String   @id @default(uuid())
  orderId      String   @map("order_id")
  amount       Decimal  @db.Decimal(12, 2)
  reason       String
  approvedById String   @map("approved_by_id")
  approvedAt   DateTime @default(now()) @map("approved_at")
  approvedBy   User     @relation(fields: [approvedById], references: [id])
  order        Order    @relation(fields: [orderId], references: [id])

  @@map("refunds")
}

/// Generic audit trail — append-only
model AuditLog {
  id          String   @id @default(uuid())
  actorId     String   @map("actor_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  beforeValue Json?    @map("before_value")
  afterValue  Json?    @map("after_value")
  timestamp   DateTime @default(now())
  actor       User     @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId, timestamp])
  @@map("audit_logs")
}

/// Log setiap edit pesanan — append-only
model OrderEditLog {
  id                  String   @id @default(uuid())
  orderId             String   @map("order_id")
  editNumber          Int      @map("edit_number")
  editedById          String   @map("edited_by_id")
  editedAt            DateTime @default(now()) @map("edited_at")
  itemsBefore         Json     @map("items_before")
  itemsAfter          Json     @map("items_after")
  totalBefore         Decimal  @map("total_before") @db.Decimal(12, 2)
  totalAfter          Decimal  @map("total_after") @db.Decimal(12, 2)
  channelBefore       String?  @map("channel_before")
  channelAfter        String?  @map("channel_after")
  customerBefore      String?  @map("customer_before")
  customerAfter       String?  @map("customer_after")
  notesBefore         String?  @map("notes_before")
  notesAfter          String?  @map("notes_after")
  paymentStatusBefore String   @map("payment_status_before")
  paymentStatusAfter  String   @map("payment_status_after")
  editedBy            User     @relation(fields: [editedById], references: [id])
  order               Order    @relation(fields: [orderId], references: [id])

  @@index([orderId, editNumber])
  @@map("order_edit_logs")
}

enum Role {
  ADMIN
  SUPERVISOR
  KASIR
}

enum OrderStatus {
  OPEN
  DONE
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PaymentMethod {
  CASH
  QRIS
  CASH_QRIS
  TRANSFER
}

enum ProductType {
  TOPPING
  DRINK
}

enum StockMovementType {
  SALE_DEDUCTION
  MANUAL_ADJUST
  CONVERSION_IN
  CONVERSION_OUT
  PURCHASE_IN
}

enum ToppingSeries {
  SPREAD
  CRUNCHY
  PREMIUM
}

enum PromoType {
  PERCENT
  FIXED_AMOUNT
  BOGO
  BUNDLE
  MIN_PURCHASE
  VOUCHER_CODE
  TIME_WINDOW
  BUY_X_GET_Y
}

enum ShiftStatus {
  OPEN
  CLOSED
}
